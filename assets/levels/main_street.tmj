     "properties": [
      {
       "name": "label",
       "type": "string",
       "value": "Street lamp"
      },
      {
       "name": "variants",
       "type": "string",
       "value": "[{\"if\":{\"phase\":\"DAY\"},\"lines\":[\"The street lamp, cold. Someone has trimmed the wick ready for tonight.\"]},{\"if\":{\"phase\":\"NIGHT\"},\"lines\":[\"The lamp is out. It has been out for some time; the glass is frosted over from inside.\"]},{\"if\":{},\"lines\":[\"A street lamp, lit. The only one on this stretch that is.\"]}]"
      }
     ]
    },
