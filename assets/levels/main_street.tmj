       "name": "label",
       "type": "string",
       "value": "Window"
      },
      {
       "name": "variants",
       "type": "string",
       "value": "[{\"if\":{\"phase\":\"DAY\"},\"lines\":[\"A cabin window, the curtain drawn even by day.\"]},{\"if\":{\"phase\":\"NIGHT\"},\"lines\":[\"Dark now, like every window on the street.\"]},{\"if\":{\"flag\":\"curtainDrawn\"},\"lines\":[\"The curtain is drawn. Whoever was watching would rather I didn't see them do it.\"]},{\"if\":{},\"lines\":[\"Someone is standing at the window, watching the street.\"]}]"
