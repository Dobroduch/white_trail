       "name": "label",
       "type": "string",
       "value": "General store"
      },
      {
       "name": "variants",
       "type": "string",
       "value": "[{\"if\":{\"phase\":\"DAY\"},\"lines\":[\"Rusk's store, open: smoke from the stovepipe, the door on the latch. The account book is gone from the window.\"]},{\"if\":{},\"lines\":[\"Rusk's general store. Dark. Through the glass: sacks, barrels, a counter, and an account book left open on it, too far off to read.\"]}]"
      }
     ]
    },
    {
