      {
       "name": "lines",
       "type": "string",
       "value": "Main Street through the glass, and the station road where it comes into town. Whoever sits at this desk sees every arrival."
      },
      {
       "name": "again",
       "type": "string",
       "value": "The glass is wiped clean in one patch, at about the height of a seated man's eyes."
      }
     ]
